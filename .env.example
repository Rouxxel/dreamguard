# DreamGuard environment variables
# Copy this file to .env (repo root) and fill in your own values.
# Never commit .env or paste your API key into chat.

# Dream Labs
DREAM_API_KEY=dl_live_REPLACE_ME
# Paid Dream-1 inference (get_action) stays disabled unless this is set to 1
DREAMGUARD_ALLOW_PAID=0

# Backend API metadata (read by backend/main.py)
API_TITLE=DreamGuard API
API_VERSION=0.1.0
API_DESCRIPTION=Safety supervisor backend for Dream-1 robot actions

# Host port published by backend/docker-compose.yml
SERVER_PORT=8000

# RSA keys (only required when backend/src/utils/en_de_crypt.py is used;
# generate them once with backend/src/utils/keys_generator.py)
E_PRIVATE_KEY=your_private_key_here
E_PRIVATE_PASSWORD=your_private_password_here
E_PUBLIC_KEY=your_public_key_here
