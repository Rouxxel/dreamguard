{
    "metadata": {
        "project": "DreamGuard",
        "description": "Safety supervisor middleware for Dream-1 robot actions",
        "maintainer": "Sebastian Russo"
    },

    "sources": {
        "fake": {
            "label": "Scripted (offline)",
            "description": "Scripted motion from the offline Dream-1 stand-in; supports fault injection",
            "paid": false
        },
        "replay": {
            "label": "Replay session",
            "description": "Replays the actions of a recorded session through the guard",
            "paid": false
        },
        "dream1": {
            "label": "Dream-1 (live)",
            "description": "Live Dream-1 inference through the Dream Labs API; every chunk is a paid call",
            "paid": true
        }
    },

    "faults": {
