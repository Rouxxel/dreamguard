        "gripper": {"label": "Gripper range", "expected_check": "gripper"},
        "missing_arm": {"label": "Missing arm", "expected_check": "action_format"},
        "mismatched_lengths": {"label": "Mismatched lengths", "expected_check": "chunk_shape"},
        "workspace": {"label": "Leave workspace", "expected_check": "workspace"},
        "separation": {"label": "Grippers collide", "expected_check": "separation"}
