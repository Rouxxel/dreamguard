# Python cache files
__pycache__/
*.pyc
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.env/
.venv/

# Environment files (secrets are injected at runtime, never baked into the image)
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Docker files
DOCKERFILE
.dockerignore
docker-compose.yml
docker-compose.*.yml

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation
README.md
*.md
docs/

# Test files
tests/
test_*.py
*_test.py

# Logs (will be created in container)
logs/
*.log

# Development tools
.pytest_cache/
.coverage
.tox/
.mypy_cache/
.pylintrc

# Node.js
node_modules/
npm-debug.log*

# Temporary files
*.tmp
*.temp