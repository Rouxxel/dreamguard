#############################################################################
### Multi-stage Dockerfile for the DreamGuard backend
### FastAPI + Uvicorn + Python 3.12 + MuJoCo (software rendering)
### Build context: repository root (see docker-compose.yml)
#############################################################################

# Build stage
FROM python:3.12-slim AS builder

WORKDIR /build

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install the DreamGuard core library (with the simulator) and the backend dependencies
COPY pyproject.toml README.md ./
COPY src ./src
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir --user ".[sim]" -r backend/requirements.txt

# Production stage
FROM python:3.12-slim

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# Install runtime dependencies (OSMesa: offscreen OpenGL without a GPU)
RUN apt-get update && apt-get install -y \
    curl \
    libosmesa6 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy Python packages from builder stage
COPY --from=builder /root/.local /home/appuser/.local

# Copy application code
COPY backend/ .

# Create logs directory (sessions are written to logs/sessions)
RUN mkdir -p logs && chown -R appuser:appuser logs

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV PATH=/home/appuser/.local/bin:$PATH
ENV MUJOCO_GL=osmesa
ENV PYOPENGL_PLATFORM=osmesa

# Change ownership of app directory
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

# Expose port (configurable via environment)
EXPOSE 8000

# Run the application (bind all interfaces inside the container)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
