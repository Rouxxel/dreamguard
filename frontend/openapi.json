            "type": "integer"
          },
          "prompt": {
            "default": "",
            "title": "Prompt",
            "type": "string"
          },
          "replay_session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replay Session Id"
          },
          "rows_played": {
            "default": 0,
            "title": "Rows Played",
            "type": "integer"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
