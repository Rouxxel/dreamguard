  "info": {
    "description": "Safety supervisor backend for Dream-1 robot actions",
    "title": "DreamGuard API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Root endpoint to verify that the API is operational.\n\nThis endpoint serves as a basic health check and confirms that the application\nis running correctly. It is rate-limited according to the configuration.\n\nParameters:\n    request (Request): The incoming HTTP request for limit event management.\n\nReturns:\n    dict: A JSON response indicating that the API is running, plus the state of\n    the simulator, camera rendering, the Dream SDK and the paid-call switch.\n\nNote:\n    If the rate limit is exceeded, the rate_limit_handler() function handles the response.",
        "operationId": "root_endpoint__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root Endpoint",
        "tags": [
          "health"
        ]
      }
    },
    "/api/runs": {
      "post": {
        "description": "Start a run with the scripted (fake), replay or Dream-1 source.\n\nParameters:\n    request (Request): Incoming HTTP request (required by the rate limiter).\n    body (RunCreate): Source, prompt, optional chunk limit and replay session.\n\nReturns:\n    RunResponse: Status of the started run (its run_id is the session id).\n\nNote:\n    The dream1 source is refused (403) unless paid calls are enabled in both\n    config_file.json and .env. Only one run can be active (409 otherwise).",
        "operationId": "start_run_api_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/catalog": {
      "get": {
        "description": "Get the run catalog.\n\nParameters:\n    request (Request): Incoming HTTP request (required by the rate limiter).\n\nReturns:\n    CatalogResponse: Sources, faults (with descriptions), cameras, joints and\n    whether paid Dream-1 calls are currently allowed.",
        "operationId": "get_catalog_api_runs_catalog_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Catalog",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/current": {
      "get": {
        "description": "Get the current run status.\n\nParameters:\n    request (Request): Incoming HTTP request (required by the rate limiter).\n\nReturns:\n    RunResponse: Run status; state is idle when no run has been started.",
        "operationId": "get_current_run_api_runs_current_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Current Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/{run_id}/faults": {
      "post": {
        "description": "Inject a fault into the next chunk.\n\nParameters:\n    request (Request): Incoming HTTP request (required by the rate limiter).\n    run_id (str): Id of the current, running scripted run.\n    body (FaultCreate): Fault id from the catalog.\n\nReturns:\n    FaultResponse: The accepted fault and its description.",
        "operationId": "inject_fault_api_runs__run_id__faults_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaultCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaultResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Inject Fault",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/{run_id}/reset": {
      "post": {
        "description": "Clear the halt of a run.\n\nParameters:\n    request (Request): Incoming HTTP request (required by the rate limiter).\n    run_id (str): Id of the current, halted run.\n\nReturns:\n    RunResponse: Status of the resumed run (409 if it is not halted).",
        "operationId": "reset_run_api_runs__run_id__reset_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
