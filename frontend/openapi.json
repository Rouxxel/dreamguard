{
  "components": {
    "schemas": {
      "CatalogResponse": {
        "description": "Sources, faults, cameras and joints the dashboard can offer.",
        "properties": {
          "cameras": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Cameras",
            "type": "object"
          },
          "faults": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FaultInfo"
            },
            "title": "Faults",
            "type": "object"
          },
          "joint_names": {
            "items": {
              "type": "string"
            },
            "title": "Joint Names",
            "type": "array"
          },
          "paid_calls_allowed": {
            "title": "Paid Calls Allowed",
            "type": "boolean"
          },
          "sources": {
            "additionalProperties": {
              "$ref": "#/components/schemas/SourceInfo"
            },
            "title": "Sources",
            "type": "object"
          }
        },
        "required": [
          "sources",
          "faults",
          "cameras",
          "joint_names",
          "paid_calls_allowed"
        ],
        "title": "CatalogResponse",
        "type": "object"
      },
      "FaultCreate": {
        "description": "POST body to inject a fault into the next chunk of a scripted run.",
